# Database Configuration
DB_HOST=localhost
DB_PORT=5432
# When using docker-compose db, use DB_PORT=5433 and DB_NAME=geospatial (port 5433 avoids conflict with host Postgres)
DB_NAME=geojson_db
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# Database Connection Pool Configuration
DB_POOL_MIN=2
DB_POOL_MAX=10

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8091
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL. Logs are JSON to stdout only.
LOG_LEVEL=INFO

# Environment Configuration
# Values: development, staging, production
ENV=development

# ==============================================================================
# STRICT AUTHENTICATION MODE (AUTH_MODE) - REQUIRED
# ==============================================================================
# Controls how requests are authenticated. This is STRICTLY enforced.
# There is NO optional auth path - every request must be authenticated
# according to the configured mode (except dev_open in non-production).
#
# Allowed values:
#   - dev_open:        DEVELOPMENT ONLY - allows all unauthenticated requests
#                      WARNING: BLOCKED if ENV=production (startup will fail)
#   - service_api_key: STRICT - all requests MUST have valid X-API-Key header
#                      Requires: API_KEYS with at least one key (16+ chars)
#   - user_jwt:        STRICT - all requests MUST have valid JWT Bearer token  
#                      Requires: JWT_SECRET (32+ chars) OR Cognito config
#   - combined:        STRICT - all requests MUST have X-API-Key OR JWT
#                      Requires: Both API_KEYS and JWT config
#
# Startup validation (service will FAIL TO START if violated):
#   - dev_open + ENV=production → BLOCKED
#   - service_api_key/combined without API_KEYS → BLOCKED
#   - user_jwt/combined without JWT config → BLOCKED
#   - API keys shorter than 16 characters → BLOCKED
#   - JWT_SECRET shorter than 32 characters → BLOCKED
# ==============================================================================
AUTH_MODE=service_api_key

# API Key Authentication (REQUIRED for service_api_key and combined modes)
# Generate a secure key: openssl rand -hex 32
# Multiple keys can be comma-separated: key1,key2,key3
# MINIMUM: Each key must be at least 16 characters
API_KEYS=your-secret-api-key-here-min-16-chars

# JWT Authentication (REQUIRED for user_jwt and combined modes)
# Choose Option A (simple HS256) OR Option B (Cognito JWKS)
#
# Option A: Simple HS256 JWT (for non-Cognito JWTs)
# Generate a secure key: openssl rand -hex 64
# MINIMUM: Must be at least 32 characters
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=
JWT_AUDIENCE=

# Option B: AWS Cognito JWT (recommended for production)
# Set these to enable Cognito JWT verification via JWKS
# COGNITO_REGION: AWS region where your user pool is located
# COGNITO_USER_POOL_ID: User pool ID (e.g., us-east-1_aBcDeFgHi)
# COGNITO_CLIENT_ID: App client ID for audience validation
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Security Configuration
MAX_REQUEST_SIZE=10485760  # 10MB in bytes
MAX_FILE_SIZE=52428800     # 50MB in bytes
RATE_LIMIT=60              # requests per minute

# CityGuard (GPS ping) – timeouts and limits (no hardcoded values in production)
CITYGUARD_REQUEST_TIMEOUT_S=3
CITYGUARD_DB_STATEMENT_TIMEOUT_S=2
CITYGUARD_MAX_BODY_BYTES=2048

# CloudWatch Logging (optional - for AWS deployment)
CLOUDWATCH_LOG_GROUP=/aws/eks/geojson-ingestion
CLOUDWATCH_LOG_STREAM=geojson-ingestion-pod

# AWS Configuration (for ECR and EKS deployment)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=  # Set your AWS account ID here
ECR_REPOSITORY_NAME=silver-saas-geojson-ingestion

# Production Database (RDS) - Uncomment and configure for production
# DB_HOST=your-rds-endpoint.rds.amazonaws.com
# DB_NAME=geojson_db
# DB_SSLMODE=require

# Local Development Database
# DB_HOST=localhost
# DB_NAME=geospatial
# DB_SSLMODE=disable
