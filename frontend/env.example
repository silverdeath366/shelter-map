# CityGuard Dashboard – env for local serve / token injection
# Mapbox token for map tiles (get from Mapbox account).
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token

# If dashboard is not on same origin as API:
# CITYGUARD_API_BASE=http://localhost:8091

# If CityGuard API requires API key:
# CITYGUARD_API_KEY=your-api-key
